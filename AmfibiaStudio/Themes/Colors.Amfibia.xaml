<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Цвета темы «Amfibia». Стили берут их через DynamicResource, поэтому тема меняется без перезапуска -->
    <SolidColorBrush x:Key="Bg" Color="#0B0B0C"/>
    <SolidColorBrush x:Key="Sidebar" Color="#0F0F11"/>
    <SolidColorBrush x:Key="Surface" Color="#141416"/>
    <SolidColorBrush x:Key="Surface2" Color="#1B1B1E"/>
    <SolidColorBrush x:Key="Surface3" Color="#25252A"/>
    <SolidColorBrush x:Key="Line" Color="#2A2A2F"/>
    <SolidColorBrush x:Key="LineStrong" Color="#3B3B42"/>
    <SolidColorBrush x:Key="Text" Color="#EDE6DA"/>
    <SolidColorBrush x:Key="TextSoft" Color="#C9C2B6"/>
    <SolidColorBrush x:Key="Muted" Color="#8A857D"/>
    <SolidColorBrush x:Key="Accent" Color="#D9707F"/>
    <SolidColorBrush x:Key="AccentHover" Color="#E8909C"/>
    <SolidColorBrush x:Key="AccentText" Color="#0B0B0C"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#2AD9707F"/>
    <SolidColorBrush x:Key="Success" Color="#7FC79B"/>
    <SolidColorBrush x:Key="Error" Color="#F0838F"/>
    <SolidColorBrush x:Key="Gold" Color="#C9A227"/>
    <SolidColorBrush x:Key="Selection" Color="#33D9707F"/>
</ResourceDictionary>
