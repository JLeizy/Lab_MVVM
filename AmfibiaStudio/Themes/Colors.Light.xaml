<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Цвета темы «Light». Стили берут их через DynamicResource, поэтому тема меняется без перезапуска -->
    <SolidColorBrush x:Key="Bg" Color="#F7F5F2"/>
    <SolidColorBrush x:Key="Sidebar" Color="#EFECE6"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Surface2" Color="#F4F1EC"/>
    <SolidColorBrush x:Key="Surface3" Color="#E9E4DC"/>
    <SolidColorBrush x:Key="Line" Color="#E2DCD2"/>
    <SolidColorBrush x:Key="LineStrong" Color="#CFC8BD"/>
    <SolidColorBrush x:Key="Text" Color="#0B0B0C"/>
    <SolidColorBrush x:Key="TextSoft" Color="#2B2926"/>
    <SolidColorBrush x:Key="Muted" Color="#5E5A55"/>
    <SolidColorBrush x:Key="Accent" Color="#B23A48"/>
    <SolidColorBrush x:Key="AccentHover" Color="#C9505E"/>
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#22B23A48"/>
    <SolidColorBrush x:Key="Success" Color="#2E7D4F"/>
    <SolidColorBrush x:Key="Error" Color="#C0392B"/>
    <SolidColorBrush x:Key="Gold" Color="#9C7A12"/>
    <SolidColorBrush x:Key="Selection" Color="#22B23A48"/>
</ResourceDictionary>
