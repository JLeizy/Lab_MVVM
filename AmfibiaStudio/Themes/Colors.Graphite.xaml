<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Цвета темы «Graphite». Стили берут их через DynamicResource, поэтому тема меняется без перезапуска -->
    <SolidColorBrush x:Key="Bg" Color="#151517"/>
    <SolidColorBrush x:Key="Sidebar" Color="#111113"/>
    <SolidColorBrush x:Key="Surface" Color="#1C1C1F"/>
    <SolidColorBrush x:Key="Surface2" Color="#232327"/>
    <SolidColorBrush x:Key="Surface3" Color="#2D2D32"/>
    <SolidColorBrush x:Key="Line" Color="#303036"/>
    <SolidColorBrush x:Key="LineStrong" Color="#44444C"/>
    <SolidColorBrush x:Key="Text" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSoft" Color="#D6D6DC"/>
    <SolidColorBrush x:Key="Muted" Color="#9A9AA0"/>
    <SolidColorBrush x:Key="Accent" Color="#7EA6E0"/>
    <SolidColorBrush x:Key="AccentHover" Color="#9BBBEA"/>
    <SolidColorBrush x:Key="AccentText" Color="#0E1116"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#2A7EA6E0"/>
    <SolidColorBrush x:Key="Success" Color="#7FC79B"/>
    <SolidColorBrush x:Key="Error" Color="#F0838F"/>
    <SolidColorBrush x:Key="Gold" Color="#D9B44A"/>
    <SolidColorBrush x:Key="Selection" Color="#337EA6E0"/>
</ResourceDictionary>
