<Window x:Class="AmfibiaStudio.Views.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подтверждение" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" FontFamily="{StaticResource FontBody}">
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="8" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" Color="Black"/>
        </Border.Effect>
        <StackPanel Margin="28,26,28,24">
            <TextBlock Text="ПОДТВЕРЖДЕНИЕ" Style="{StaticResource T.Eyebrow}"/>
            <TextBlock x:Name="HeaderText" Style="{StaticResource T.H2}" Margin="0,6,0,10" AutomationProperties.AutomationId="DialogTitle"/>
            <TextBlock x:Name="MessageText" Style="{StaticResource T.Body}" AutomationProperties.AutomationId="DialogMessage"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="Отмена" Style="{StaticResource Btn.Ghost}" IsCancel="True" Click="Cancel_Click" Margin="0,0,10,0"
                        AutomationProperties.AutomationId="DialogCancel"/>
                <Button x:Name="ConfirmButton" Style="{StaticResource Btn.Primary}" IsDefault="True" Click="Confirm_Click"
                        AutomationProperties.AutomationId="DialogConfirm"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
