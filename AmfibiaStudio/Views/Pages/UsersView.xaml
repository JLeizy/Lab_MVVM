<UserControl x:Class="AmfibiaStudio.Views.Pages.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12">
                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Roles}" DisplayMemberPath="Title" SelectedValuePath="Key" SelectedValue="{Binding Role}"
                          Width="190" Margin="10,0,0,0" AutomationProperties.AutomationId="UsersRole"/>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}" Tag="Поиск: имя, email, город, телефон"
                         AutomationProperties.AutomationId="UsersSearch"/>
            </DockPanel>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8,14,8,8">
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutomationProperties.AutomationId="UsersGrid">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="ПОЛЬЗОВАТЕЛЬ" Width="*" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Text}"/>
                                        <TextBlock Text="{Binding Email}" FontSize="11" Foreground="{DynamicResource Muted}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="РОЛЬ" Binding="{Binding Role}" Width="130"/>
                        <DataGridTextColumn Header="ГОРОД" Binding="{Binding City}" Width="110"/>
                        <DataGridTextColumn Header="ЗАКАЗЫ" Binding="{Binding OrdersCount}" Width="70"/>
                        <DataGridTextColumn Header="ПОТРАТИЛ" Binding="{Binding SpentText}" Width="110" SortMemberPath="Spent"/>
                        <DataGridTemplateColumn Header="СТАТУС" Width="110" SortMemberPath="Blocked">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="StateText" Text="{Binding State}" FontSize="12" Foreground="{DynamicResource Success}" VerticalAlignment="Center"/>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Blocked}" Value="True">
                                            <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource Error}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- ===== Карточка пользователя ===== -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <TextBlock Text="Выберите пользователя" Style="{StaticResource T.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Selected, Converter={StaticResource EmptyToCollapsed}, ConverterParameter=invert}"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Selected, Converter={StaticResource EmptyToCollapsed}}">
                    <StackPanel Margin="22,22,22,22">
                        <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Selected.User.Initials}" FontFamily="{StaticResource FontDisplay}" FontSize="28" Foreground="{DynamicResource Accent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding Selected.Name}" Style="{StaticResource T.H2}" Margin="0,14,0,2" AutomationProperties.AutomationId="UserCardName"/>
                        <TextBlock Text="{Binding Selected.Role}" Style="{StaticResource T.Eyebrow}" Margin="0,0,0,16"/>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Email" Style="{StaticResource T.Muted}" Margin="0,0,0,8"/>
                            <TextBlock Grid.Column="1" Text="{Binding Selected.Email}" FontSize="13" Foreground="{DynamicResource Text}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="1" Text="Телефон" Style="{StaticResource T.Muted}" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Selected.Phone}" FontSize="13" Foreground="{DynamicResource Text}"/>
                            <TextBlock Grid.Row="2" Text="Город" Style="{StaticResource T.Muted}" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Selected.City}" FontSize="13" Foreground="{DynamicResource Text}"/>
                            <TextBlock Grid.Row="3" Text="С нами с" Style="{StaticResource T.Muted}" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Selected.User.Registered, StringFormat=dd.MM.yyyy}" FontSize="13" Foreground="{DynamicResource Text}"/>
                            <TextBlock Grid.Row="4" Text="Статус" Style="{StaticResource T.Muted}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Selected.State}" FontSize="13" Foreground="{DynamicResource Text}"
                                       AutomationProperties.AutomationId="UserCardState"/>
                        </Grid>

                        <UniformGrid Columns="2" Margin="0,0,0,18">
                            <Border Background="{DynamicResource Surface2}" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Заказов" Style="{StaticResource T.Muted}"/>
                                    <TextBlock Text="{Binding Selected.OrdersCount}" FontFamily="{StaticResource FontDisplay}" FontSize="26" Foreground="{DynamicResource Text}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource Surface2}" CornerRadius="6" Padding="12" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Потратил" Style="{StaticResource T.Muted}"/>
                                    <TextBlock Text="{Binding Selected.SpentText}" FontFamily="{StaticResource FontDisplay}" FontSize="22" Foreground="{DynamicResource Text}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <TextBlock Text="ПОСЛЕДНИЕ ЗАКАЗЫ" Style="{StaticResource T.Eyebrow}" Margin="0,0,0,8"
                                   Visibility="{Binding SelectedOrders, Converter={StaticResource EmptyToCollapsed}}"/>
                        <ItemsControl ItemsSource="{Binding SelectedOrders}" Focusable="False" Margin="0,0,0,18">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource TextSoft}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="{Binding BlockText}" Style="{StaticResource Btn.Danger}" Command="{Binding ToggleBlockCommand}"
                                AutomationProperties.AutomationId="ToggleBlock"/>
                        <TextBlock Style="{StaticResource T.Muted}" FontSize="11" Margin="0,8,0,0"
                                   Text="Блокируют владелец, модератор и поддержка. Нельзя заблокировать себя и владельца."/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
