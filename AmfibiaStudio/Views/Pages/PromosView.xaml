<UserControl x:Class="AmfibiaStudio.Views.Pages.PromosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="+ Новый промокод" Style="{StaticResource Btn.Primary}" Padding="14,8" FontSize="12"
                        Command="{Binding NewCommand}" AutomationProperties.AutomationId="NewPromo"/>
                <TextBlock Text="Скидка промокода применяется к сумме товаров; бесплатная доставка считается по сумме после скидки."
                           Style="{StaticResource T.Muted}" VerticalAlignment="Center"/>
            </DockPanel>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8,14,8,8">
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutomationProperties.AutomationId="PromosGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="КОД" Binding="{Binding Code}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="FontSize" Value="14"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="СКИДКА" Binding="{Binding Percent}" Width="80" SortMemberPath="Promo.Percent">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                    <Setter Property="FontFamily" Value="{StaticResource FontSemi}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="ДЕЙСТВУЕТ" Binding="{Binding Period}" Width="190" SortMemberPath="Promo.ValidFrom"/>
                        <DataGridTextColumn Header="ИСПОЛЬЗОВАН" Binding="{Binding Usage}" Width="130" SortMemberPath="Used"/>
                        <DataGridTemplateColumn Header="СОСТОЯНИЕ" Width="130" SortMemberPath="State">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="StateText" Text="{Binding State}" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource Success}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- ===== Редактор промокода: поля проверяются при вводе ===== -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="22,20,22,22">
                    <TextBlock Text="РЕДАКТОР" Style="{StaticResource T.Eyebrow}"/>
                    <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource T.H2}" Margin="0,4,0,18" AutomationProperties.AutomationId="PromoEditorTitle"/>
                    <TextBlock Text="Только просмотр: промокоды меняет владелец магазина." Style="{StaticResource T.Muted}" Margin="0,0,0,14"
                               Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>

                    <StackPanel IsEnabled="{Binding CanEdit}">
                        <TextBlock Text="Код" Style="{StaticResource T.Label}"/>
                        <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" CharacterCasing="Upper" Margin="0,0,0,26"
                                 AutomationProperties.AutomationId="PromoCode"/>

                        <TextBlock Text="Скидка, %" Style="{StaticResource T.Label}"/>
                        <TextBox Text="{Binding PercentText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,26" AutomationProperties.AutomationId="PromoPercent"/>

                        <Grid Margin="0,0,0,26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="С (ДД.ММ.ГГГГ)" Style="{StaticResource T.Label}"/>
                                <TextBox Text="{Binding FromText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="PromoFrom"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="По (пусто — бессрочно)" Style="{StaticResource T.Label}"/>
                                <TextBox Text="{Binding ToText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="PromoTo"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Лимит использований (пусто — без лимита)" Style="{StaticResource T.Label}"/>
                        <TextBox Text="{Binding LimitText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,26" AutomationProperties.AutomationId="PromoLimit"/>

                        <CheckBox Content="Промокод включён" IsChecked="{Binding Active}" Margin="0,0,0,22"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Сохранить" Style="{StaticResource Btn.Primary}" Command="{Binding SaveCommand}" Margin="0,0,10,0"
                                AutomationProperties.AutomationId="SavePromo"/>
                        <Button Content="Удалить" Style="{StaticResource Btn.Danger}" Command="{Binding DeleteCommand}" AutomationProperties.AutomationId="DeletePromo"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
