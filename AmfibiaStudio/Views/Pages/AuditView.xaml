<UserControl x:Class="AmfibiaStudio.Views.Pages.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Users}" DisplayMemberPath="Title" SelectedValuePath="Key" SelectedValue="{Binding User}"
                      Width="220" Margin="10,0,0,0" AutomationProperties.AutomationId="AuditUser"/>
            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}" Tag="Поиск по действию и подробностям"
                     AutomationProperties.AutomationId="AuditSearch"/>
        </DockPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8,14,8,8">
            <DataGrid ItemsSource="{Binding Items}" VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.AutomationId="AuditGrid">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="КОГДА" Binding="{Binding At, StringFormat='dd.MM.yyyy HH:mm'}" Width="140"/>
                    <DataGridTextColumn Header="СОТРУДНИК" Binding="{Binding User}" Width="190"/>
                    <DataGridTextColumn Header="ДЕЙСТВИЕ" Binding="{Binding Action}" Width="200">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                <Setter Property="FontFamily" Value="{StaticResource FontMedium}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="ПОДРОБНОСТИ" Binding="{Binding Details}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="ToolTip" Value="{Binding Details}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
