<UserControl x:Class="AmfibiaStudio.Views.Pages.BrandsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Плитка бренда в списке слева: фон — градиент палитры бренда, название — шрифтом бренда -->
        <Style x:Key="BrandItem" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Frame" BorderBrush="Transparent" BorderThickness="2" CornerRadius="7" Margin="0,0,6,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Абзац статьи: вид зависит от Kind (p, h, li, quote) -->
        <DataTemplate x:Key="BlockTemplate">
            <Grid x:Name="Root" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Marker" Width="0"/>
                <TextBlock x:Name="Text" Grid.Column="1" Text="{Binding Text}" Style="{StaticResource T.Body}"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="h">
                    <Setter TargetName="Text" Property="FontFamily" Value="{StaticResource FontDisplay}"/>
                    <Setter TargetName="Text" Property="FontSize" Value="20"/>
                    <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource Text}"/>
                    <Setter TargetName="Root" Property="Margin" Value="0,8,0,6"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="li">
                    <Setter TargetName="Marker" Property="Width" Value="6"/>
                    <Setter TargetName="Marker" Property="Height" Value="6"/>
                    <Setter TargetName="Marker" Property="CornerRadius" Value="3"/>
                    <Setter TargetName="Marker" Property="Background" Value="{DynamicResource Accent}"/>
                    <Setter TargetName="Marker" Property="VerticalAlignment" Value="Top"/>
                    <Setter TargetName="Marker" Property="Margin" Value="4,8,12,0"/>
                    <Setter TargetName="Root" Property="Margin" Value="0,0,0,6"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="quote">
                    <Setter TargetName="Marker" Property="Width" Value="3"/>
                    <Setter TargetName="Marker" Property="Background" Value="{DynamicResource Accent}"/>
                    <Setter TargetName="Marker" Property="Margin" Value="0,0,14,0"/>
                    <Setter TargetName="Text" Property="FontFamily" Value="{StaticResource FontDisplayItalic}"/>
                    <Setter TargetName="Text" Property="FontStyle" Value="Italic"/>
                    <Setter TargetName="Text" Property="FontSize" Value="18"/>
                    <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource Text}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Модные дома ===== -->
        <ListBox ItemsSource="{Binding Brands}" SelectedItem="{Binding Selected}" ItemContainerStyle="{StaticResource BrandItem}"
                 AutomationProperties.AutomationId="BrandList">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="5" Padding="14,10" AutomationProperties.Name="{Binding Name}">
                        <Border.Background>
                            <MultiBinding Converter="{StaticResource Gradient}">
                                <Binding Path="Bg"/>
                                <Binding Path="Bg2"/>
                            </MultiBinding>
                        </Border.Background>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontFamily="{Binding FontKey, Converter={StaticResource BrandFont}}" FontSize="19"
                                       Foreground="{Binding Fg, Converter={StaticResource HexBrush}}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{Binding Fg, Converter={StaticResource HexBrush}}" Opacity="0.7" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ===== Статья о бренде ===== -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border CornerRadius="8" Padding="28,22" Margin="0,0,0,14" DataContext="{Binding Selected}"
                    TextElement.Foreground="{Binding Fg, Converter={StaticResource HexBrush}}">
                <Border.Background>
                    <MultiBinding Converter="{StaticResource Gradient}">
                        <Binding Path="Bg"/>
                        <Binding Path="Bg2"/>
                    </MultiBinding>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontFamily="{Binding FontKey, Converter={StaticResource BrandFont}}" FontSize="44"
                                   Foreground="{Binding Fg, Converter={StaticResource HexBrush}}" AutomationProperties.AutomationId="BrandName"/>
                        <TextBlock Foreground="{Binding Fg, Converter={StaticResource HexBrush}}" Opacity="0.8" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap">
                            <Run Text="{Binding Brand.Origin, Mode=OneWay}"/> <Run Text="·"/> <Run Text="основан в"/> <Run Text="{Binding Brand.Founded, Mode=OneWay}"/>
                            <Run Text="·"/> <Run Text="{Binding Brand.Founder, Mode=OneWay}"/>
                        </TextBlock>
                        <Border Height="2" Width="56" HorizontalAlignment="Left" Margin="0,14,0,0" Background="{Binding Accent, Converter={StaticResource HexBrush}}"/>
                    </StackPanel>
                    <!-- Показатели магазина по бренду -->
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding DataContext.Stats, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  VerticalAlignment="Center" Focusable="False" AutomationProperties.AutomationId="BrandStats">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#26000000" CornerRadius="6" Padding="14,8" Margin="6,0,0,6" MinWidth="130">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Value}" FontFamily="{StaticResource FontDisplay}" FontSize="20"/>
                                        <TextBlock Text="{Binding Label}" FontSize="11" Opacity="0.75"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Вкладки статьи — это состояние самого Вида (какой блок показать), поэтому оно не во ViewModel -->
            <DockPanel Grid.Row="1" Margin="0,0,0,12">
                <TextBlock DockPanel.Dock="Right" Text="{Binding FoundText}" Style="{StaticResource T.Muted}" VerticalAlignment="Center" Margin="12,0,0,0"
                           AutomationProperties.AutomationId="FoundText"/>
                <TextBox DockPanel.Dock="Right" Width="230" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=300}" Tag="Поиск по статье"
                         AutomationProperties.AutomationId="ArticleSearch"/>
                <ListBox x:Name="Tabs" SelectedIndex="0" ItemContainerStyle="{StaticResource Item.Chip}" ItemsPanel="{StaticResource HorizontalPanel}"
                         HorizontalAlignment="Left" AutomationProperties.AutomationId="BrandTabs">
                    <ListBoxItem Content="История"/>
                    <ListBoxItem Content="Хронология"/>
                    <ListBoxItem Content="Директора"/>
                    <ListBoxItem Content="Коллекции"/>
                    <ListBoxItem Content="О бренде"/>
                </ListBox>
            </DockPanel>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <!-- История: полная статья с сайта (виртуализированный список разделов) -->
                    <ItemsControl ItemsSource="{Binding Sections}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                                  Visibility="{Binding SelectedIndex, ElementName=Tabs, Converter={StaticResource EqualsToVisibility}, ConverterParameter=0}"
                                  AutomationProperties.AutomationId="ArticleSections">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer CanContentScroll="True" Focusable="False" HorizontalScrollBarVisibility="Disabled" Padding="28,22,28,8">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,26" MaxWidth="860" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Period}" Style="{StaticResource T.Eyebrow}"/>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource T.H2}" Margin="0,4,0,12"/>
                                    <ItemsControl ItemsSource="{Binding Blocks}" ItemTemplate="{StaticResource BlockTemplate}" Focusable="False"/>
                                    <Border BorderBrush="{DynamicResource Accent}" BorderThickness="3,0,0,0" Padding="16,6" Margin="0,6,0,0"
                                            Visibility="{Binding Quote, Converter={StaticResource EmptyToCollapsed}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Quote}" FontFamily="{StaticResource FontDisplayItalic}" FontStyle="Italic" FontSize="20"
                                                       Foreground="{DynamicResource Text}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding QuoteAuthor}" Style="{StaticResource T.Muted}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Хронология -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,22"
                                  Visibility="{Binding SelectedIndex, ElementName=Tabs, Converter={StaticResource EqualsToVisibility}, ConverterParameter=1}">
                        <ItemsControl ItemsSource="{Binding Timeline}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="86"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Year}" FontFamily="{StaticResource FontDisplay}" FontSize="26" Foreground="{DynamicResource Accent}"/>
                                        <Border Grid.Column="1" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0" Padding="18,2,0,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontFamily="{StaticResource FontSemi}" FontSize="14" Foreground="{DynamicResource Text}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource T.Body}" FontSize="13" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Креативные директора -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22"
                                  Visibility="{Binding SelectedIndex, ElementName=Tabs, Converter={StaticResource EqualsToVisibility}, ConverterParameter=2}">
                        <ItemsControl ItemsSource="{Binding Directors}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Surface2}" CornerRadius="6" Padding="18,16" Margin="0,0,12,12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Period}" Style="{StaticResource T.Eyebrow}"/>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource T.H3}" Margin="0,4,0,8"/>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource T.Body}" FontSize="13"/>
                                            <TextBlock Style="{StaticResource T.Muted}" Margin="0,8,0,0" Visibility="{Binding KeyWorks, Converter={StaticResource EmptyToCollapsed}}">
                                                <Run Text="Ключевые работы:" Foreground="{DynamicResource TextSoft}"/> <Run Text="{Binding KeyWorks, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Коллекции -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22"
                                  Visibility="{Binding SelectedIndex, ElementName=Tabs, Converter={StaticResource EqualsToVisibility}, ConverterParameter=3}">
                        <ItemsControl ItemsSource="{Binding Collections}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Surface2}" CornerRadius="6" Padding="16,14" Margin="0,0,12,12">
                                        <StackPanel>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Background="{DynamicResource Accent}" CornerRadius="8" Padding="7,1"
                                                        Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="новая" FontSize="10" Foreground="{DynamicResource AccentText}"/>
                                                </Border>
                                                <TextBlock Style="{StaticResource T.Eyebrow}">
                                                    <Run Text="{Binding SeasonName, Mode=OneWay}"/> <Run Text="{Binding Year, Mode=OneWay}"/>
                                                </TextBlock>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource T.H3}" FontSize="18" Margin="0,4,0,6"/>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource T.Muted}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- О бренде -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,22"
                                  Visibility="{Binding SelectedIndex, ElementName=Tabs, Converter={StaticResource EqualsToVisibility}, ConverterParameter=4}">
                        <TextBlock Text="{Binding Description}" Style="{StaticResource T.Body}" FontSize="15" LineHeight="25" MaxWidth="820" HorizontalAlignment="Left"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
