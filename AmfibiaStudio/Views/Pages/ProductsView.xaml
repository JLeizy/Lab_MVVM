<UserControl x:Class="AmfibiaStudio.Views.Pages.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AmfibiaStudio.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="390"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Таблица товаров ===== -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Фильтры: каждое поле привязано к свойству ViewModel, список фильтруется при вводе -->
            <WrapPanel>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}" Tag="Поиск: название, артикул, бренд"
                         Width="250" Margin="0,0,10,10" AutomationProperties.AutomationId="ProductsSearch"/>
                <ComboBox ItemsSource="{Binding Brands}" DisplayMemberPath="Title" SelectedValuePath="Key" SelectedValue="{Binding Brand}"
                          Width="180" Margin="0,0,10,10" AutomationProperties.AutomationId="ProductsBrand"/>
                <ComboBox ItemsSource="{Binding Groups}" DisplayMemberPath="Title" SelectedValuePath="Key" SelectedValue="{Binding Group}"
                          Width="160" Margin="0,0,10,10" AutomationProperties.AutomationId="ProductsGroup"/>
            </WrapPanel>

            <DockPanel Grid.Row="1" Margin="0,0,0,12" LastChildFill="False">
                <CheckBox Content="Ресейл" IsChecked="{Binding OnlyPreowned}" Margin="0,0,18,0"/>
                <CheckBox Content="Со скидкой" IsChecked="{Binding OnlySale}" Margin="0,0,18,0"/>
                <CheckBox Content="Мало на складе" IsChecked="{Binding OnlyLowStock}" Margin="0,0,18,0" AutomationProperties.AutomationId="ProductsLowStock"/>
                <Button Content="Сбросить" Style="{StaticResource Btn.Link}" Command="{Binding ResetFiltersCommand}" FontSize="12"/>
            </DockPanel>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8,14,8,4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- SelectedItem ↔ Selected: выбор строки открывает карточку товара справа -->
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" RowHeight="50"
                              VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.AutomationId="ProductsGrid">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="54" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="38" Height="38" CornerRadius="4" ClipToBounds="True">
                                            <c:ProductArt Product="{Binding Product}" ShowWatermark="False"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="АРТИКУЛ" Binding="{Binding Id}" Width="126"/>
                            <DataGridTemplateColumn Header="НАЗВАНИЕ" Width="*" SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Category, Mode=OneWay}"/> <Run Text="{Binding Flags, Mode=OneWay}" Foreground="{DynamicResource Accent}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="БРЕНД" Binding="{Binding Brand}" Width="130"/>
                            <DataGridTemplateColumn Header="ЦЕНА" Width="104" SortMemberPath="Price">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PriceText}" Foreground="{DynamicResource Text}" FontFamily="{StaticResource FontMedium}"/>
                                            <TextBlock Text="{Binding OldPriceText}" FontSize="11" Foreground="{DynamicResource Muted}" TextDecorations="Strikethrough"
                                                       Visibility="{Binding OldPriceText, Converter={StaticResource EmptyToCollapsed}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="СКЛАД" Width="70" SortMemberPath="Stock">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="StockText" Text="{Binding Stock}" Foreground="{DynamicResource TextSoft}" VerticalAlignment="Center"/>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                <Setter TargetName="StockText" Property="Foreground" Value="{DynamicResource Error}"/>
                                                <Setter TargetName="StockText" Property="FontFamily" Value="{StaticResource FontSemi}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Text="{Binding CountText}" Style="{StaticResource T.Muted}" Margin="10,8,0,6"
                               AutomationProperties.AutomationId="ProductsCount"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== Действия и карточка редактирования (ProductEditorViewModel) ===== -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <UniformGrid Columns="3" Margin="0,0,0,12">
                <Button Content="+ Новый товар" Style="{StaticResource Btn.Primary}" Padding="10,10" FontSize="12" Margin="0,0,6,0"
                        Command="{Binding NewCommand}" AutomationProperties.AutomationId="NewProduct"/>
                <Button Content="Копия" Style="{StaticResource Btn.Ghost}" Padding="10,10" FontSize="12" Margin="3,0"
                        Command="{Binding DuplicateCommand}" AutomationProperties.AutomationId="DuplicateProduct"/>
                <Button Content="Удалить" Style="{StaticResource Btn.Danger}" Padding="10,10" FontSize="12" Margin="6,0,0,0"
                        Command="{Binding DeleteCommand}" AutomationProperties.AutomationId="DeleteProduct"/>
            </UniformGrid>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30"
                            Visibility="{Binding Editor, Converter={StaticResource EmptyToCollapsed}, ConverterParameter=invert}">
                    <TextBlock Text="❦" FontSize="40" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Выберите товар в таблице или создайте новый" Style="{StaticResource T.Muted}" TextAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>

                <ScrollViewer DataContext="{Binding Editor}" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding Converter={StaticResource EmptyToCollapsed}}">
                    <StackPanel Margin="22,20,22,22">
                        <TextBlock Text="КАРТОЧКА ТОВАРА" Style="{StaticResource T.Eyebrow}"/>
                        <TextBlock Text="{Binding Header}" Style="{StaticResource T.H2}" Margin="0,4,0,14" AutomationProperties.AutomationId="EditorHeader"/>
                        <Border CornerRadius="6" ClipToBounds="True" Height="170" Margin="0,0,0,18">
                            <c:ProductArt Product="{Binding Product}"/>
                        </Border>

                        <TextBlock Text="Только просмотр: редактируют владелец, модератор и продавец." Style="{StaticResource T.Muted}" Margin="0,0,0,14"
                                   Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>

                        <StackPanel IsEnabled="{Binding CanEdit}">
                            <TextBlock Text="Название" Style="{StaticResource T.Label}"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,24" AutomationProperties.AutomationId="EditorName"/>

                            <TextBlock Text="Название на английском" Style="{StaticResource T.Label}"/>
                            <TextBox Text="{Binding NameEn, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,24"/>

                            <TextBlock Text="Бренд (меняется только у нового товара)" Style="{StaticResource T.Label}"/>
                            <ComboBox ItemsSource="{Binding BrandOptions}" DisplayMemberPath="Title" SelectedValuePath="Key" SelectedValue="{Binding BrandSlug}"
                                      IsEnabled="{Binding CanChangeBrand}" Margin="0,0,0,20"/>

                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Категория" Style="{StaticResource T.Label}"/>
                                    <ComboBox ItemsSource="{Binding CategoryOptions}" DisplayMemberPath="Title" SelectedValuePath="Key" SelectedValue="{Binding CategorySlug}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Цвет" Style="{StaticResource T.Label}"/>
                                    <ComboBox ItemsSource="{Binding ColorOptions}" DisplayMemberPath="Title" SelectedValuePath="Key" SelectedValue="{Binding ColorCode}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Цена, BYN" Style="{StaticResource T.Label}"/>
                                    <TextBox Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="EditorPrice"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Старая цена (скидка)" Style="{StaticResource T.Label}"/>
                                    <TextBox Text="{Binding OldPriceText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="EditorOldPrice"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Описание" Style="{StaticResource T.Label}"/>
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="96"
                                     VerticalContentAlignment="Top" Margin="0,0,0,24" AutomationProperties.AutomationId="EditorDescription"/>

                            <CheckBox Content="Новинка" IsChecked="{Binding IsNewArrival}" Margin="0,0,0,10"/>
                            <CheckBox Content="Культовая модель" IsChecked="{Binding Iconic}" Margin="0,0,0,10"/>
                            <CheckBox Content="Ресейл (один экземпляр)" IsChecked="{Binding Preowned}" Margin="0,0,0,24"
                                      Validation.ErrorTemplate="{StaticResource FieldError}"/>
                        </StackPanel>

                        <!-- Сохранить доступна, только если есть изменения и нет ошибок (SaveCommand.CanExecute) -->
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Сохранить" Style="{StaticResource Btn.Primary}" Command="{Binding SaveCommand}" Margin="0,0,10,0"
                                    AutomationProperties.AutomationId="SaveProduct"/>
                            <Button Content="Отменить изменения" Style="{StaticResource Btn.Ghost}" Command="{Binding RevertCommand}"
                                    AutomationProperties.AutomationId="RevertProduct"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</UserControl>
