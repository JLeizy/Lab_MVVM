<UserControl x:Class="AmfibiaStudio.Views.Pages.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ThemeItem" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Frame" BorderBrush="{DynamicResource Line}" BorderThickness="2" CornerRadius="8" Margin="0,0,14,14" Padding="3">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0">
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="ТЕМА ОФОРМЛЕНИЯ" Style="{StaticResource T.Eyebrow}"/>
                    <TextBlock Text="Меняется сразу, без перезапуска — все цвета подключены через DynamicResource" Style="{StaticResource T.Muted}" Margin="0,4,0,16"/>
                    <!-- SelectedItem ↔ SelectedTheme: ViewModel вызывает IThemeService.Apply -->
                    <ListBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" ItemContainerStyle="{StaticResource ThemeItem}"
                             ItemsPanel="{StaticResource WrapPanel}" AutomationProperties.AutomationId="ThemeList">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="250" CornerRadius="6" Background="{Binding Bg, Converter={StaticResource HexBrush}}" Padding="18,16"
                                        AutomationProperties.Name="{Binding Title}">
                                    <StackPanel>
                                        <TextBlock Text="AMFIBIA" FontFamily="{StaticResource FontLogo}" FontSize="26" Foreground="{Binding Fg, Converter={StaticResource HexBrush}}"/>
                                        <Border Height="3" Width="48" HorizontalAlignment="Left" Margin="0,8,0,12" Background="{Binding Accent, Converter={StaticResource HexBrush}}"/>
                                        <TextBlock Text="{Binding Title}" FontFamily="{StaticResource FontSemi}" FontSize="14" Foreground="{Binding Fg, Converter={StaticResource HexBrush}}"/>
                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{Binding Fg, Converter={StaticResource HexBrush}}" Opacity="0.7"
                                                   TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="ДАННЫЕ" Style="{StaticResource T.Eyebrow}"/>
                    <TextBlock Text="{Binding DataInfo}" Style="{StaticResource T.Body}" Margin="0,8,0,14"/>
                    <Button Content="Вернуть демо-данные сайта" Style="{StaticResource Btn.Danger}" Command="{Binding ResetCommand}" HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="ResetDemo"/>
                    <TextBlock Text="Сбросить данные может только владелец магазина. После сброса нужно войти снова." Style="{StaticResource T.Muted}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="О ПРОГРАММЕ" Style="{StaticResource T.Eyebrow}"/>
                    <TextBlock Text="AMFIBIA Studio" Style="{StaticResource T.H2}" Margin="0,6,0,6"/>
                    <TextBlock Style="{StaticResource T.Body}"
                               Text="Лабораторная работа: WPF-приложение по шаблону MVVM (Model — View — ViewModel). Панель управления маркетплейсом брендовой одежды AMFIBIA: данные, роли сотрудников и правила заказов взяты с сайта Fashion_site."/>
                    <TextBlock Style="{StaticResource T.Muted}" Margin="0,12,0,0" LineHeight="19"
                               Text="Model — данные и правила (Models, Services). View — разметка XAML без логики (Views). ViewModel — состояние и команды страниц (ViewModels): Вид связан с ней только привязками {Binding}, командами ICommand и уведомлениями INotifyPropertyChanged и INotifyDataErrorInfo."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
