<UserControl x:Class="AmfibiaStudio.Views.Pages.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AmfibiaStudio.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="0,0,8,0">
            <!-- Период: SelectedIndex привязан к PeriodIndex, ViewModel пересчитывает всё сама -->
            <DockPanel Margin="0,0,0,18">
                <Button DockPanel.Dock="Right" Content="Все заказы →" Style="{StaticResource Btn.Link}" Command="{Binding OpenCommand}" CommandParameter="orders"
                        VerticalAlignment="Center"/>
                <ListBox ItemsSource="{Binding Periods}" SelectedIndex="{Binding PeriodIndex}" ItemContainerStyle="{StaticResource Item.Chip}"
                         ItemsPanel="{StaticResource HorizontalPanel}" HorizontalAlignment="Left" AutomationProperties.AutomationId="PeriodList"/>
            </DockPanel>

            <!-- KPI -->
            <ItemsControl ItemsSource="{Binding Kpis}" Focusable="False" AutomationProperties.AutomationId="KpiList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,14,14" Padding="20,16">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource T.Label}"/>
                                <TextBlock Text="{Binding Value}" FontFamily="{StaticResource FontDisplay}" FontSize="30" Foreground="{DynamicResource Text}"/>
                                <TextBlock Text="{Binding Hint}" Style="{StaticResource T.Muted}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,0,14,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Столбчатая диаграмма выручки: высота столбца = Ratio × 170 (RatioToLengthConverter) -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding RevenueTitle}" Style="{StaticResource T.H3}"/>
                        <TextBlock Style="{StaticResource T.Muted}" Margin="0,2,0,14">
                            <Run Text="Всего:"/> <Run Text="{Binding Kpis[0].Value, Mode=OneWay}" Foreground="{DynamicResource Accent}"/>
                            <Run Text="· без отменённых и возвращённых заказов"/>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding RevenueBars}" Height="200" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Background="Transparent">
                                        <Grid.ToolTip>
                                            <TextBlock><Run Text="{Binding Label, Mode=OneWay}"/> <Run Text="{Binding ValueText, Mode=OneWay}"/></TextBlock>
                                        </Grid.ToolTip>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="20"/>
                                        </Grid.RowDefinitions>
                                        <Border x:Name="Bar" VerticalAlignment="Bottom" Margin="2,0" CornerRadius="3,3,0,0" Background="{DynamicResource Accent}"
                                                Height="{Binding Ratio, Converter={StaticResource RatioToLength}, ConverterParameter=170}" Opacity="0.85"/>
                                        <TextBlock Grid.Row="1" Text="{Binding Label}" FontSize="10" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center"
                                                   VerticalAlignment="Bottom" TextTrimming="None"/>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bar" Property="Opacity" Value="1"/>
                                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource AccentHover}"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Кольцевая диаграмма статусов -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Статусы заказов" Style="{StaticResource T.H3}"/>
                        <TextBlock Text="за выбранный период" Style="{StaticResource T.Muted}" Margin="0,2,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <c:DonutChart Segments="{Binding StatusSegments}" CenterText="{Binding OrdersTotalText}" Width="150" Height="150"
                                          Thickness="20" Foreground="{DynamicResource Text}" Track="{DynamicResource Surface3}" VerticalAlignment="Top"/>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding StatusSegments}" Margin="16,0,0,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="9" Height="9" Fill="{Binding Color, Converter={StaticResource HexBrush}}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource TextSoft}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" FontSize="12" Foreground="{DynamicResource Muted}" Margin="8,0,0,0">
                                                <Run Text="{Binding Count, Mode=OneWay}" Foreground="{DynamicResource Text}"/> <Run Text="{Binding PercentText, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,0,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1.15*"/>
                </Grid.ColumnDefinitions>

                <!-- Лучшие бренды: горизонтальные полосы -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Бренды по выручке" Style="{StaticResource T.H3}" Margin="0,0,0,14"/>
                        <ItemsControl ItemsSource="{Binding TopBrands}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ValueText}" FontSize="12" Foreground="{DynamicResource Muted}"/>
                                            <TextBlock Text="{Binding Label}" FontSize="13" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <Border Background="{DynamicResource Surface3}" CornerRadius="3" Height="6" Margin="0,6,0,0">
                                            <Border Background="{DynamicResource Accent}" CornerRadius="3" HorizontalAlignment="Left"
                                                    Width="{Binding Ratio, Converter={StaticResource RatioToLength}, ConverterParameter=260}"/>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Хиты продаж -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Хиты продаж" Style="{StaticResource T.H3}" Margin="0,0,0,14"/>
                        <ItemsControl ItemsSource="{Binding TopProducts}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border CornerRadius="4" ClipToBounds="True" Width="46" Height="46">
                                            <c:ProductArt Product="{Binding Product}" ShowWatermark="False"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Brand}" FontSize="11" Foreground="{DynamicResource Accent}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Revenue}" FontFamily="{StaticResource FontSemi}" FontSize="12" Foreground="{DynamicResource Text}" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding Sold}" FontSize="11" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Последние действия сотрудников -->
                <Border Grid.Column="4" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <Button DockPanel.Dock="Right" Content="Журнал →" Style="{StaticResource Btn.Link}" Command="{Binding OpenCommand}" CommandParameter="audit"
                                    FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="Последние действия" Style="{StaticResource T.H3}"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding RecentActions}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,6,0,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontSize="13" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Action, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Details}" FontSize="12" Foreground="{DynamicResource TextSoft}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource Muted}">
                                                <Run Text="{Binding At, StringFormat=dd.MM.yyyy HH:mm, Mode=OneWay}"/> <Run Text="·"/> <Run Text="{Binding User, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
