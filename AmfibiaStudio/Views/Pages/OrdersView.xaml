<UserControl x:Class="AmfibiaStudio.Views.Pages.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AmfibiaStudio.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="390"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Список заказов ===== -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ListBox ItemsSource="{Binding TabNames}" SelectedIndex="{Binding Tab}" ItemContainerStyle="{StaticResource Item.Chip}"
                     ItemsPanel="{StaticResource WrapPanel}" Margin="0,0,0,12" AutomationProperties.AutomationId="OrderTabs"/>
            <DockPanel Grid.Row="1" Margin="0,0,0,12">
                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource T.Muted}" VerticalAlignment="Center" Margin="12,0,0,0"
                           AutomationProperties.AutomationId="OrdersCount"/>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}" Tag="Поиск: номер заказа, покупатель, телефон, трек-номер"
                         AutomationProperties.AutomationId="OrdersSearch"/>
            </DockPanel>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8,14,8,8">
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" VirtualizingPanel.ScrollUnit="Pixel"
                          AutomationProperties.AutomationId="OrdersGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="НОМЕР" Binding="{Binding Number}" Width="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                    <Setter Property="FontFamily" Value="{StaticResource FontMedium}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="ДАТА" Binding="{Binding Date}" Width="128" SortMemberPath="Order.Created"/>
                        <DataGridTextColumn Header="ПОКУПАТЕЛЬ" Binding="{Binding Customer}" Width="*"/>
                        <DataGridTextColumn Header="СУММА" Binding="{Binding Total}" Width="96" SortMemberPath="Order.Total"/>
                        <DataGridTemplateColumn Header="СТАТУС" Width="146" SortMemberPath="Status">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatusPill}">
                                        <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource Text}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- ===== Карточка заказа ===== -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <TextBlock Text="Выберите заказ" Style="{StaticResource T.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Selected, Converter={StaticResource EmptyToCollapsed}, ConverterParameter=invert}"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Selected, Converter={StaticResource EmptyToCollapsed}}">
                    <StackPanel Margin="22,20,22,22">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" DataContext="{Binding Selected}" Style="{StaticResource StatusPill}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource Text}" AutomationProperties.AutomationId="OrderStatus"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="ЗАКАЗ" Style="{StaticResource T.Eyebrow}"/>
                                <TextBlock Text="{Binding Selected.Number}" Style="{StaticResource T.H2}" AutomationProperties.AutomationId="OrderNumber"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{Binding StatusHelp}" Style="{StaticResource T.Muted}" Margin="0,6,0,16"/>

                        <!-- Шкала статусов, как на странице отслеживания сайта -->
                        <ItemsControl ItemsSource="{Binding Steps}" Focusable="False" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="34">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Линия к предыдущему шагу (у первого шага её нет) -->
                                        <Rectangle x:Name="Line" Width="2" Height="22" Fill="{DynamicResource Line}" HorizontalAlignment="Center"
                                                   VerticalAlignment="Top" Margin="0,-19,0,0"/>
                                        <Ellipse x:Name="Dot" Width="12" Height="12" VerticalAlignment="Top" Margin="0,3,0,0" Fill="{DynamicResource Surface}"
                                                 Stroke="{DynamicResource LineStrong}" StrokeThickness="2"/>
                                        <TextBlock x:Name="Title" Grid.Column="1" Text="{Binding Title}" FontSize="13" Foreground="{DynamicResource Muted}" Margin="6,0,0,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Time}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,1,0,0"/>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="done">
                                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Accent}"/>
                                            <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource Accent}"/>
                                            <Setter TargetName="Line" Property="Fill" Value="{DynamicResource Accent}"/>
                                            <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource TextSoft}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="current">
                                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentSoft}"/>
                                            <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource Accent}"/>
                                            <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource Text}"/>
                                            <Setter TargetName="Title" Property="FontFamily" Value="{StaticResource FontSemi}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="cancelled">
                                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Error}"/>
                                            <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource Error}"/>
                                            <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource Error}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="current">
                                            <Setter TargetName="Line" Property="Fill" Value="{DynamicResource Accent}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                            <Setter TargetName="Line" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Действия: доступность кнопок — CanExecute команд (правила и права роли во ViewModel) -->
                        <Border Background="{DynamicResource Surface2}" CornerRadius="6" Padding="14" Margin="0,0,0,18">
                            <StackPanel>
                                <Button Content="{Binding AdvanceText}" Style="{StaticResource Btn.Primary}" Command="{Binding AdvanceCommand}"
                                        AutomationProperties.AutomationId="AdvanceOrder"/>
                                <TextBlock Text="{Binding RuleHint}" Style="{StaticResource T.Muted}" Margin="0,8,0,0"
                                           Visibility="{Binding RuleHint, Converter={StaticResource EmptyToCollapsed}}" AutomationProperties.AutomationId="RuleHint"/>

                                <StackPanel Visibility="{Binding NeedsCourier, Converter={StaticResource BoolToVisibility}}" Margin="0,12,0,0">
                                    <TextBlock Text="Курьер для доставки" Style="{StaticResource T.Label}"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Назначить" Style="{StaticResource Btn.Small}" Command="{Binding AssignCourierCommand}"
                                                Margin="8,0,0,0" AutomationProperties.AutomationId="AssignCourier"/>
                                        <ComboBox ItemsSource="{Binding Couriers}" DisplayMemberPath="Title" SelectedValuePath="Key" SelectedValue="{Binding CourierEmail}"
                                                  AutomationProperties.AutomationId="CourierBox"/>
                                    </DockPanel>
                                </StackPanel>

                                <UniformGrid Columns="2" Margin="0,12,0,0">
                                    <Button Content="Оплата получена" Style="{StaticResource Btn.Small}" Command="{Binding MarkPaidCommand}" Margin="0,0,6,0"
                                            AutomationProperties.AutomationId="MarkPaid"/>
                                    <Button Content="Отменить заказ" Style="{StaticResource Btn.Danger}" Padding="12,6" FontSize="12" Command="{Binding CancelCommand}"
                                            Margin="6,0,0,0" AutomationProperties.AutomationId="CancelOrder"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Сведения -->
                        <Grid DataContext="{Binding Selected}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Покупатель" Style="{StaticResource T.Muted}" Margin="0,0,0,8"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource T.Value}" FontFamily="{StaticResource FontBody}" FontSize="13">
                                <Run Text="{Binding Customer, Mode=OneWay}"/><LineBreak/><Run Text="{Binding Phone, Mode=OneWay}" Foreground="{DynamicResource Muted}"/>
                                <Run Text="·" Foreground="{DynamicResource Muted}"/> <Run Text="{Binding Email, Mode=OneWay}" Foreground="{DynamicResource Muted}"/>
                            </TextBlock>
                            <TextBlock Grid.Row="1" Text="Доставка" Style="{StaticResource T.Muted}" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource T.Value}" FontFamily="{StaticResource FontBody}" FontSize="13" Margin="0,0,0,8">
                                <Run Text="{Binding Delivery, Mode=OneWay}"/><LineBreak/>
                                <Run Text="{Binding DataContext.AddressText, Mode=OneWay, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{DynamicResource Muted}"/>
                            </TextBlock>
                            <TextBlock Grid.Row="2" Text="Оплата" Style="{StaticResource T.Muted}" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" FontSize="13" Foreground="{DynamicResource Text}" TextWrapping="Wrap"
                                       Text="{Binding DataContext.PaymentText, RelativeSource={RelativeSource AncestorType=UserControl}}" AutomationProperties.AutomationId="OrderPayment"/>
                            <TextBlock Grid.Row="3" Text="Курьер" Style="{StaticResource T.Muted}" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" FontSize="13" Foreground="{DynamicResource Text}"
                                       Text="{Binding DataContext.CourierText, RelativeSource={RelativeSource AncestorType=UserControl}}" AutomationProperties.AutomationId="OrderCourier"/>
                            <TextBlock Grid.Row="4" Text="Трек-номер" Style="{StaticResource T.Muted}" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Tracking}" Margin="0,0,0,8" FontSize="13" FontFamily="Consolas" Foreground="{DynamicResource Text}"/>
                        </Grid>

                        <TextBlock Text="СОСТАВ ЗАКАЗА" Style="{StaticResource T.Eyebrow}" Margin="0,12,0,10"/>
                        <ItemsControl ItemsSource="{Binding Lines}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="4" ClipToBounds="True">
                                            <c:ProductArt Product="{Binding Product}" ShowWatermark="False"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource Text}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Total}" FontSize="13" FontFamily="{StaticResource FontMedium}" Foreground="{DynamicResource Text}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,10,0,0" DataContext="{Binding Selected}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Товары" Style="{StaticResource T.Muted}"/>
                                <TextBlock Grid.Column="1" Text="{Binding SubtotalText}" FontSize="12" Foreground="{DynamicResource TextSoft}"/>
                                <TextBlock Grid.Row="1" Text="Скидка" Style="{StaticResource T.Muted}" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DiscountText}" FontSize="12" Foreground="{DynamicResource TextSoft}" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="2" Text="Доставка" Style="{StaticResource T.Muted}" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DeliveryPriceText}" FontSize="12" Foreground="{DynamicResource TextSoft}" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="3" Text="Итого" FontFamily="{StaticResource FontSemi}" FontSize="14" Foreground="{DynamicResource Text}" Margin="0,8,0,0"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Total}" FontFamily="{StaticResource FontDisplay}" FontSize="22"
                                           Foreground="{DynamicResource Accent}" Margin="0,4,0,0"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
