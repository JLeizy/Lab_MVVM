<UserControl x:Class="AmfibiaStudio.Views.Pages.ReviewsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AmfibiaStudio.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Сводка оценок ===== -->
        <StackPanel>
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="СРЕДНЯЯ ОЦЕНКА" Style="{StaticResource T.Eyebrow}"/>
                    <TextBlock Text="{Binding AverageText}" FontFamily="{StaticResource FontDisplay}" FontSize="56" Foreground="{DynamicResource Text}"
                               AutomationProperties.AutomationId="AverageRating"/>
                    <TextBlock Text="по опубликованным отзывам" Style="{StaticResource T.Muted}" Margin="0,0,0,16"/>
                    <ItemsControl ItemsSource="{Binding Distribution}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="34"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource Gold}" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="{DynamicResource Surface3}" CornerRadius="3" Height="8">
                                        <Border Background="{DynamicResource Gold}" CornerRadius="3" HorizontalAlignment="Left"
                                                Width="{Binding Ratio, Converter={StaticResource RatioToLength}, ConverterParameter=168}"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontSize="12" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="ПРАВИЛА МОДЕРАЦИИ" Style="{StaticResource T.Eyebrow}" Margin="0,0,0,8"/>
                    <TextBlock Style="{StaticResource T.Muted}" FontSize="12" LineHeight="19"
                               Text="Отзыв может оставить только покупатель, получивший заказ. Новый отзыв попадает на модерацию и появляется на сайте после публикации. Модерируют владелец, модератор и поддержка."/>
                    <TextBlock Margin="0,12,0,0" FontSize="13" Foreground="{DynamicResource Text}">
                        <Run Text="Ждут проверки:"/> <Run Text="{Binding PendingCount, Mode=OneWay}" Foreground="{DynamicResource Accent}" FontFamily="{StaticResource FontSemi}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ===== Отзывы ===== -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12">
                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource T.Muted}" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="ReviewsCount"/>
                <ListBox ItemsSource="{Binding TabNames}" SelectedIndex="{Binding Tab}" ItemContainerStyle="{StaticResource Item.Chip}"
                         ItemsPanel="{StaticResource HorizontalPanel}" HorizontalAlignment="Left" AutomationProperties.AutomationId="ReviewTabs"/>
            </DockPanel>

            <ListBox Grid.Row="1" ItemsSource="{Binding Items}" ItemContainerStyle="{StaticResource Item.Card}" VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.AutomationId="ReviewsList">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer Focusable="False" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="64" Height="64" CornerRadius="5" ClipToBounds="True" VerticalAlignment="Top">
                                <c:ProductArt Product="{Binding Product}" ShowWatermark="False"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="16,0,16,0">
                                <TextBlock FontSize="11" Foreground="{DynamicResource Accent}" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Brand, Mode=OneWay}"/> <Run Text="·" Foreground="{DynamicResource Muted}"/> <Run Text="{Binding ProductName, Mode=OneWay}" Foreground="{DynamicResource Muted}"/>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                                    <TextBlock Text="{Binding Stars}" FontSize="14" Foreground="{DynamicResource Gold}"/>
                                    <TextBlock Text="{Binding Author}" FontFamily="{StaticResource FontSemi}" FontSize="13" Foreground="{DynamicResource Text}" Margin="12,0,0,0"/>
                                    <TextBlock Text="{Binding Date}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="10,1,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Text}" Style="{StaticResource T.Body}" FontSize="13" LineHeight="20"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Width="150">
                                <Border Style="{StaticResource StatusPill}" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource Text}"/>
                                </Border>
                                <!-- Команды страницы: параметр — строка отзыва -->
                                <StackPanel Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}}" Margin="0,12,0,0">
                                    <Button Content="Опубликовать" Style="{StaticResource Btn.Primary}" Padding="12,7" FontSize="12" Margin="0,0,0,6"
                                            Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                            AutomationProperties.AutomationId="ApproveReview"/>
                                    <Button Content="Отклонить" Style="{StaticResource Btn.Small}"
                                            Command="{Binding DataContext.RejectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                            AutomationProperties.AutomationId="RejectReview"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
