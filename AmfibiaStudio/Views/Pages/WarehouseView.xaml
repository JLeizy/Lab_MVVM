<UserControl x:Class="AmfibiaStudio.Views.Pages.WarehouseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AmfibiaStudio.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12">
                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource T.Muted}" VerticalAlignment="Center" Margin="14,0,0,0"
                           AutomationProperties.AutomationId="StockCount"/>
                <CheckBox DockPanel.Dock="Right" Content="Только заканчивающиеся" IsChecked="{Binding OnlyLow}" Margin="14,0,0,0"
                          AutomationProperties.AutomationId="OnlyLow"/>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}" Tag="Поиск: название, артикул, бренд"
                         AutomationProperties.AutomationId="StockSearch"/>
            </DockPanel>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8,14,8,8">
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" RowHeight="48" VirtualizingPanel.ScrollUnit="Pixel"
                          AutomationProperties.AutomationId="StockGrid">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="52" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Width="36" Height="36" CornerRadius="4" ClipToBounds="True">
                                        <c:ProductArt Product="{Binding Product}" ShowWatermark="False"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ТОВАР" Width="*" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource Muted}">
                                            <Run Text="{Binding Id, Mode=OneWay}"/> <Run Text="·"/> <Run Text="{Binding Brand, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="МИНСК" Binding="{Binding Minsk}" Width="70"/>
                        <DataGridTextColumn Header="МОСКВА" Binding="{Binding Moscow}" Width="74"/>
                        <DataGridTextColumn Header="АЛМАТЫ" Binding="{Binding Almaty}" Width="74"/>
                        <DataGridTextColumn Header="ВСЕГО" Binding="{Binding Total}" Width="64">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                    <Setter Property="FontFamily" Value="{StaticResource FontSemi}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="СОСТОЯНИЕ" Width="120" SortMemberPath="Total">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="StateText" Text="{Binding State}" FontSize="12" Foreground="{DynamicResource Success}" VerticalAlignment="Center"/>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsLow}" Value="True">
                                            <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource Error}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Product.Preowned}" Value="True">
                                            <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource Gold}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- ===== Выбранный товар: остатки, перемещение, приход ===== -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="22,20,22,22">
                    <TextBlock Text="ОСТАТКИ ТОВАРА" Style="{StaticResource T.Eyebrow}"/>
                    <TextBlock Text="{Binding Selected.Name}" Style="{StaticResource T.H3}" Margin="0,4,0,2" AutomationProperties.AutomationId="StockName"/>
                    <TextBlock Style="{StaticResource T.Muted}" Margin="0,0,0,14">
                        <Run Text="{Binding Selected.Id, Mode=OneWay}"/> <Run Text="·"/> <Run Text="{Binding Selected.Brand, Mode=OneWay}"/>
                    </TextBlock>
                    <Border CornerRadius="6" ClipToBounds="True" Height="140" Margin="0,0,0,16">
                        <c:ProductArt Product="{Binding Selected.Product}"/>
                    </Border>

                    <UniformGrid Columns="3" Margin="0,0,0,18">
                        <Border Background="{DynamicResource Surface2}" CornerRadius="6" Padding="10,10" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="Минск" Style="{StaticResource T.Muted}"/>
                                <TextBlock Text="{Binding Selected.Minsk}" FontFamily="{StaticResource FontDisplay}" FontSize="26" Foreground="{DynamicResource Text}"
                                           AutomationProperties.AutomationId="StockMinsk"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource Surface2}" CornerRadius="6" Padding="10,10" Margin="3,0">
                            <StackPanel>
                                <TextBlock Text="Москва" Style="{StaticResource T.Muted}"/>
                                <TextBlock Text="{Binding Selected.Moscow}" FontFamily="{StaticResource FontDisplay}" FontSize="26" Foreground="{DynamicResource Text}"
                                           AutomationProperties.AutomationId="StockMoscow"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource Surface2}" CornerRadius="6" Padding="10,10" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Алматы" Style="{StaticResource T.Muted}"/>
                                <TextBlock Text="{Binding Selected.Almaty}" FontFamily="{StaticResource FontDisplay}" FontSize="26" Foreground="{DynamicResource Text}"
                                           AutomationProperties.AutomationId="StockAlmaty"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Перемещение: поле «Количество» проверяется во ViewModel (не больше остатка, склады разные) -->
                    <TextBlock Text="ПЕРЕМЕЩЕНИЕ МЕЖДУ СКЛАДАМИ" Style="{StaticResource T.Eyebrow}" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Warehouses}" SelectedIndex="{Binding FromIndex}" AutomationProperties.AutomationId="FromBox"/>
                        <TextBlock Grid.Column="1" Text="→" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="16"/>
                        <ComboBox Grid.Column="2" ItemsSource="{Binding Warehouses}" SelectedIndex="{Binding ToIndex}" AutomationProperties.AutomationId="ToBox"/>
                    </Grid>
                    <Grid Margin="0,0,0,26">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" Tag="Количество" AutomationProperties.AutomationId="TransferQty"/>
                        <Button Grid.Column="1" Content="Переместить" Style="{StaticResource Btn.Primary}" Command="{Binding TransferCommand}" Margin="10,0,0,0"
                                VerticalAlignment="Top" AutomationProperties.AutomationId="TransferButton"/>
                    </Grid>

                    <TextBlock Text="ПРИХОД ТОВАРА" Style="{StaticResource T.Eyebrow}" Margin="0,4,0,10"/>
                    <ComboBox ItemsSource="{Binding Warehouses}" SelectedIndex="{Binding ReceiveIndex}" Margin="0,0,0,12" AutomationProperties.AutomationId="ReceiveBox"/>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding ReceiveText, UpdateSourceTrigger=PropertyChanged}" Tag="Количество" AutomationProperties.AutomationId="ReceiveQty"/>
                        <Button Grid.Column="1" Content="Принять" Style="{StaticResource Btn.Ghost}" Command="{Binding ReceiveCommand}" Margin="10,0,0,0"
                                VerticalAlignment="Top" AutomationProperties.AutomationId="ReceiveButton"/>
                    </Grid>
                    <TextBlock Style="{StaticResource T.Muted}"
                               Text="При сборке заказа товар списывается автоматически: сначала со склада в Минске, затем Москва и Алматы. Отмена собранного заказа возвращает вещи в Минск."/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
