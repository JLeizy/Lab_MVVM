<UserControl x:Class="AmfibiaStudio.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext = ShellViewModel: меню по роли, текущая страница, сотрудник -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Боковое меню ===== -->
        <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="24,24,24,22">
                    <TextBlock Text="AMFIBIA" FontFamily="{StaticResource FontLogo}" FontSize="38" Foreground="{DynamicResource Text}"/>
                    <TextBlock Text="S T U D I O" Style="{StaticResource T.Eyebrow}" Margin="2,0,0,0"/>
                </StackPanel>

                <!-- Выбор пункта меняет SelectedItem во ViewModel, а она открывает страницу -->
                <ListBox Grid.Row="1" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedItem}" AutomationProperties.AutomationId="NavList">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource Item.Nav}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid AutomationProperties.Name="{Binding Title}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" FontSize="15" FontFamily="Segoe UI Symbol" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontFamily="{StaticResource FontMedium}" FontSize="14" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                <Border Grid.Column="2" Background="{DynamicResource Accent}" CornerRadius="9" MinWidth="22" Height="18" Padding="6,0"
                                        Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding Badge}" FontFamily="{StaticResource FontSemi}" FontSize="11" Foreground="{DynamicResource AccentText}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Сотрудник и выход -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}" BorderThickness="1">
                            <TextBlock Text="{Binding Initials}" FontFamily="{StaticResource FontSemi}" FontSize="14" Foreground="{DynamicResource Accent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AutomationId="UserInitials"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserName}" FontFamily="{StaticResource FontSemi}" FontSize="13" Foreground="{DynamicResource Text}"
                                       TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="UserName"/>
                            <TextBlock Text="{Binding UserRole}" FontSize="12" Foreground="{DynamicResource Muted}" AutomationProperties.AutomationId="UserRole"/>
                            <Button Content="Выйти" Style="{StaticResource Btn.Link}" Command="{Binding LogoutCommand}" HorizontalAlignment="Left"
                                    FontSize="12" Margin="0,4,0,0" AutomationProperties.AutomationId="LogoutButton"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ===== Страница ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="32,22,32,18">
                <StackPanel>
                    <TextBlock Text="{Binding CurrentPage.Title}" Style="{StaticResource T.H1}" FontSize="32" AutomationProperties.AutomationId="PageTitle"/>
                    <TextBlock Text="{Binding CurrentPage.Subtitle}" Style="{StaticResource T.Muted}" FontSize="13" Margin="0,4,0,0"
                               AutomationProperties.AutomationId="PageSubtitle"/>
                </StackPanel>
            </Border>

            <!-- WPF подбирает Вид страницы по типу ViewModel (DataTemplate в App.xaml) -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Focusable="False" Margin="32,20,32,24"/>
        </Grid>
    </Grid>
</UserControl>
