<UserControl x:Class="AmfibiaStudio.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AmfibiaStudio.Controls">
    <!-- DataContext = LoginViewModel. Поля привязаны к свойствам, кнопки — к командам -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая половина: бренд и витрина -->
        <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
            <Grid Margin="56,48">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="AMFIBIA" FontFamily="{StaticResource FontLogo}" FontSize="76" Foreground="{DynamicResource Text}"/>
                    <TextBlock Text="S T U D I O" Style="{StaticResource T.Eyebrow}" FontSize="13" Margin="4,0,0,0"/>
                    <TextBlock Text="Панель управления маркетплейсом брендовой одежды" Style="{StaticResource T.H2}"
                               Margin="0,26,0,10" MaxWidth="520" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource T.Body}" MaxWidth="520" HorizontalAlignment="Left"
                               Text="Товары, заказы, склад, отзывы, промокоды и курсы валют сайта AMFIBIA в одном окне. Каждый сотрудник видит только свои разделы."/>
                </StackPanel>

                <!-- Витрина: рисунки культовых вещей (свойство Showcase) -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Showcase}" VerticalAlignment="Center" Margin="0,24" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,16,0">
                                <Border CornerRadius="6" ClipToBounds="True" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                    <c:ProductArt Product="{Binding}" Height="210"/>
                                </Border>
                                <TextBlock Text="{Binding Brand}" Style="{StaticResource T.Eyebrow}" Margin="0,10,0,2"/>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource T.Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Row="2" Text="{Binding Stats}" Style="{StaticResource T.Muted}"/>
            </Grid>
        </Border>

        <!-- Правая половина: форма входа -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Width="400" VerticalAlignment="Center" Margin="0,40">
                <TextBlock Text="ВХОД ДЛЯ СОТРУДНИКОВ" Style="{StaticResource T.Eyebrow}"/>
                <TextBlock Text="Добро пожаловать" Style="{StaticResource T.H1}" Margin="0,6,0,28"/>

                <TextBlock Text="Email" Style="{StaticResource T.Label}"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Tag="owner@amfibia.by"
                         AutomationProperties.AutomationId="LoginEmail" Margin="0,0,0,26"/>

                <TextBlock Text="Пароль" Style="{StaticResource T.Label}"/>
                <PasswordBox c:PasswordBoxAssistant.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="LoginPassword"/>

                <Border Background="#22F0838F" BorderBrush="{DynamicResource Error}" BorderThickness="1" CornerRadius="4" Padding="12,9" Margin="0,16,0,0"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource EmptyToCollapsed}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Error}" TextWrapping="Wrap" FontSize="13"
                               AutomationProperties.AutomationId="LoginError"/>
                </Border>

                <!-- Кнопка доступна, только когда LoginCommand.CanExecute = true (поля заполнены без ошибок) -->
                <Button Content="Войти в панель" Style="{StaticResource Btn.Primary}" Command="{Binding LoginCommand}" IsDefault="True"
                        Margin="0,22,0,0" Padding="18,13" FontSize="14" AutomationProperties.AutomationId="LoginButton"/>

                <TextBlock Text="ДЕМО-АККАУНТЫ · ПАРОЛЬ Amfibia2026" Style="{StaticResource T.Eyebrow}" Foreground="{DynamicResource Muted}" Margin="0,36,0,10"/>
                <ItemsControl ItemsSource="{Binding DemoAccounts}" Focusable="False" AutomationProperties.AutomationId="DemoAccounts">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.UseDemoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" Style="{StaticResource Btn.Ghost}" Margin="0,0,8,8" Padding="12,8"
                                    HorizontalContentAlignment="Left" ToolTip="{Binding Email}" AutomationProperties.Name="{Binding Role}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Role}" FontFamily="{StaticResource FontSemi}" FontSize="11" Foreground="{DynamicResource Accent}"/>
                                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource FontBody}" FontSize="13" Foreground="{DynamicResource Text}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
